# =====================================================
# Banco Backend - Variables de Entorno
# =====================================================
# Perfil activo de Spring (dev para local, prod para produccion)
SPRING_PROFILES_ACTIVE=dev

# =====================================================
# Base de datos (usadas por application-dev.yml)
# =====================================================
DB_HOST=localhost
DB_NAME=banco
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_PORT=5432

# =====================================================
# Puerto del contenedor (mapeo en docker-compose)
# =====================================================
SPRING_PORT=8080

# =====================================================
# URL completa para conexion Spring Boot via Docker
# (usada por docker-compose como SPRING_DATASOURCE_URL)
# =====================================================
DB_URL=jdbc:postgresql://db:5432/banco

# =====================================================
# JWT
# =====================================================
# EN PRODUCCION: cambiar por una clave de 256+ bits generada con:
#   openssl rand -base64 64
JWT_SECRET=miClaveSecretaSuperSeguraParaJWT2024Con256Bits!!
JWT_EXPIRATION=86400000

# =====================================================
# CORS (origenes permitidos separados por coma)
# =====================================================
# EN PRODUCCION: reemplazar con la URL real del frontend
# CORS_ALLOWED_ORIGINS=https://mifrontend.com
